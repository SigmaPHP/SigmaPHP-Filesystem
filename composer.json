{
    "name": "sigmaphp/sigmaphp-filesystem",
    "description": "Filesystem utilities",
    "keywords": ["filesystem", "utilities"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SigmaPHP\\Filesystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SigmaPHP\\Filesystem\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Mohamed Yousef",
            "email": "engineer.mohamed.yossef@gmail.com"
        }
    ],
    "require-dev": {
